{
  "manifest_version": 3,
  "name": "EtsyHunt — Etsy Niche Research",
  "short_name": "EtsyHunt",
  "version": "1.1.0",
  "description": "Free local Etsy niche research: find keywords, audit listings, and download scored niche reports.",
  "author": "EtsyHunt",
  "homepage_url": "https://github.com/vtoxi/EtsyHunt",
  "minimum_chrome_version": "114",
  "permissions": [
    "storage",
    "tabs",
    "scripting",
    "alarms",
    "downloads"
  ],
  "host_permissions": [
    "https://www.etsy.com/*",
    "https://members.erank.com/*"
  ],
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.etsy.com/*"
      ],
      "js": [
        "src/content-scripts/etsy-search-extractor.js",
        "src/content-scripts/etsy-listing-extractor.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://members.erank.com/*"
      ],
      "js": [
        "src/content-scripts/erank-keyword-extractor.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "EtsyHunt",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
